{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "types": ["node"],
    "rootDir": "src", "outDir": "dist", "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "declaration": true,
    "sourceMap": false, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
